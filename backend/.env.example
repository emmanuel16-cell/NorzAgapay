# TextBee SMS gateway (SMS OTP delivery)
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Use a private, random value of at least 32 characters in production.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Required in production for distributed phone/password account-write locks.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Firebase Cloud Messaging (server-only; store this JSON as a protected secret)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Public Supabase Storage bucket shared by report and broadcast media.
SUPABASE_BUCKET_NAME=norzagapay-files

# Private bucket name created by incident_resolution_documents_migration.sql.
RESOLUTION_PDF_BUCKET_NAME=incident-resolution-documents
# Set these to Times New Roman regular and bold TTF files on the API host.
# The PDF generator uses PDFKit's Times-Roman fonts if a path is not available.
TIMES_NEW_ROMAN_REGULAR_FONT_PATH=
TIMES_NEW_ROMAN_BOLD_FONT_PATH=
